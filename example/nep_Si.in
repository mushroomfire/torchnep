version    4
type       1 Si
cutoff     5 5
n_max      8 8
basis_size 8 8
l_max      4 0
neuron     50

# Stage 1 loss weights (same as GPUMD lambda_e/f/v)
lambda_e   1.0
lambda_f   100.0
lambda_v   10.0

# Training parameters
epoch      500           # number of epochs
batch      32            # batch size
lr         0.005         # initial learning rate
stop_lr    1e-6          # minimum learning rate
scheduler_patience 15    # epochs without improvement before LR reduction
scheduler_factor   0.8   # LR reduction factor
max_grad_norm      5.0  # gradient clipping

# Stage 2: energy-focused fine-tuning (MACE-style)
stage2           1       # 1=enable, 0=disable
start_stage2     400     # epoch to start Stage 2
stage2_lr        1e-4    # Stage 2 learning rate
stage2_lambda_e  1000.0  # Stage 2 energy weight
stage2_lambda_f  10.0   # Stage 2 force weight
stage2_lambda_v  10.0    # Stage 2 virial weight
use_swa          1       # Stochastic Weight Averaging (1=on, 0=off)
