
type       89 H He Li Be B C N O F Ne Na Mg Al Si P S Cl Ar K Ca Sc Ti V Cr Mn Fe Co Ni Cu Zn Ga Ge As Se Br Kr Rb Sr Y Zr Nb Mo Tc Ru Rh Pd Ag Cd In Sn Sb Te I Xe Cs Ba La Ce Pr Nd Pm Sm Eu Gd Tb Dy Ho Er Tm Yb Lu Hf Ta W Re Os Ir Pt Au Hg Tl Pb Bi Ac Th Pa U Np Pu 

version    4
zbl        2
cutoff     6 5
n_max      4 4
basis_size 8 8
l_max      4 2 1
neuron     80

# Stage 1 loss weights (same as GPUMD lambda_e/f/v)
lambda_e   10.0
lambda_f   100.0
lambda_v   1.0

# Training parameters
epoch      10           # number of epochs
batch      64            # batch size
lr         1e-2         # initial learning rate
stop_lr    1e-6          # minimum learning rate
scheduler_patience 15    # epochs without improvement before LR reduction
scheduler_factor   0.8   # LR reduction factor
max_grad_norm      20.0  # gradient clipping
